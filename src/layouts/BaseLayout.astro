---
import '@/index.css';
import { urlCanonique } from '@/lib/seo/urlCanonique.mjs';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  siteName?: string;
  jsonLd?: object;
  breadcrumbs?: BreadcrumbItem[];
  noindex?: boolean;
  /** Si true, n'injecte pas le widget de chat MessagingMe (ex: cockpit chantier). */
  noChatWidget?: boolean;
  /**
   * Image à précharger — l'élément LCP de la page, quand c'en est un.
   *
   * 🔴 2026-09-23 — POURQUOI UNE PROP ET PAS UN `<link>` DANS LA PAGE : un
   * `<link rel="preload">` écrit dans le corps d'une page Astro n'est PAS
   * hissé dans le `<head>`. Découvert tard, il n'avance rien — or tout
   * l'intérêt d'un preload est d'être lu avant le CSS.
   *
   * ⚠️ `media` N'EST PAS DÉCORATIF : le navigateur respecte cet attribut sur
   * un preload. C'est ce qui permet de ne RIEN télécharger sur mobile pour
   * une image que seul le desktop affiche.
   */
  preloadImage?: { href: string; media?: string; imagesrcset?: string; imagesizes?: string };
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = 'https://www.verifiermondevis.fr/og-image.png',
  siteName = 'VerifierMonDevis.fr',
  jsonLd,
  breadcrumbs,
  noindex = false,
  noChatWidget = false,
  preloadImage,
} = Astro.props;

// Auto-canonical : utilise l'URL explicite si fournie, sinon construit depuis Astro.url.
//
// 🔴 2026-09-21 — LA RÈGLE EST IMPORTÉE, PLUS ÉCRITE ICI. Elle existait en
// double (ici et, implicitement, dans `@astrojs/sitemap` qui écrivait l'autre
// forme) : le sitemap déclarait `/faq/` quand cette ligne produisait `/faq`.
// Les deux endroits appellent désormais `urlCanonique`. Ne pas la recopier.
//
// ⚠️ Un changement de comportement, mineur et voulu : l'ancienne version
// comparait à la chaîne VMD codée en dur, ce qui retirait le slash de la racine
// de gerermonchantier.fr. La règle porte maintenant sur le CHEMIN, donc les deux
// domaines sont traités pareil. Aucune page en production n'est concernée —
// la racine GMC passe par `/gmc-home`, qui fournit son canonical explicite.
const autoCanonical = canonical ?? urlCanonique(Astro.url.href);

// 2026-09-07 — MARQUE DÉDUITE DU CANONICAL, PAS DES EN-TÊTES.
//
// Première tentative : `Astro.request.headers.get('host')`. Elle échoue — les
// landings sont PRÉRENDUES, et Astro avertit que les en-têtes n'y existent pas
// (un avertissement par page au build). Le canonical, lui, est connu à la
// compilation et porte déjà le bon domaine sur toutes les pages GMC de contenu.
// Repli sur `Astro.url.hostname`, qui fonctionne en SSR sans avertissement.
const estGmc =
  autoCanonical.includes('gerermonchantier') ||
  Astro.url.hostname.includes('gerermonchantier');

const breadcrumbLd = breadcrumbs && breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url,
  })),
} : null;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="VerifierMonDevis.fr" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <!-- Vérification de domaine Meta Business (layout partagé : les 2 balises coexistent,
         Meta ne lit que celle qui correspond au domaine crawlé) -->
    <meta name="facebook-domain-verification" content="r54gw5ze41etkhwrgz1t5r5h55yl90" />
    <meta name="facebook-domain-verification" content="6lo9yop3msxls7me8kvm7pvb8ltooh" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="192x192" href="/favicon-192.png" />
    <link rel="preload" href="/_astro/dm-sans-latin-400-normal.CW0RaeGs.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.href}
        media={preloadImage.media}
        imagesrcset={preloadImage.imagesrcset}
        imagesizes={preloadImage.imagesizes}
        fetchpriority="high"
      />
    )}
    <link rel="canonical" href={autoCanonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={autoCanonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    {breadcrumbLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    )}

    {/* 2026-09-07 — CETTE ORGANISATION DOIT SUIVRE LE DOMAINE.
        Ce bloc était codé en dur sur VerifierMonDevis.fr — nom, URL, logo,
        e-mail, `@id` ET la note Trustpilot — alors que `BaseLayout` sert LES
        DEUX domaines. Chaque page de gerermonchantier.fr déclarait donc
        appartenir à VMD et portait ses avis Trustpilot, qui ne la concernent
        pas.
        Le hostname est déjà utilisé plus bas pour choisir le flux GA4 : on
        applique la même règle ici. */}
    <script type="application/ld+json" set:html={JSON.stringify(
      (() => {
        if (estGmc) {
          return {
            "@context": "https://schema.org",
            "@type": "Organization",
            "@id": "https://www.gerermonchantier.fr/#organization",
            "name": "GérerMonChantier",
            "url": "https://www.gerermonchantier.fr",
            "logo": {
              "@type": "ImageObject",
              "url": "https://www.gerermonchantier.fr/images/logo.webp",
              "width": 128,
              "height": 128,
            },
            "email": "contact@gerermonchantier.fr",
            "description":
              "Copilote de chantier pour particuliers : planning, budget, documents et coordination des artisans.",
            "contactPoint": {
              "@type": "ContactPoint",
              "email": "contact@gerermonchantier.fr",
              "contactType": "customer service",
              "availableLanguage": "French",
            },
            // Pas d'aggregateRating : GérerMonChantier n'a pas de profil
            // Trustpilot (la page renvoie 404) ni d'avis collectés.
          };
        }
        return {
          "@context": "https://schema.org",
          "@type": "Organization",
          "@id": "https://www.verifiermondevis.fr/#organization",
          "name": "VerifierMonDevis.fr",
          "url": "https://www.verifiermondevis.fr",
          "logo": {
            "@type": "ImageObject",
            "url": "https://www.verifiermondevis.fr/images/logo.webp",
            "width": 128,
            "height": 128,
          },
          "email": "contact@verifiermondevis.fr",
          "description":
            "Service gratuit d'analyse de devis d'artisans. Score de fiabilité, vérification entreprise, comparaison prix marché.",
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "contact@verifiermondevis.fr",
            "contactType": "customer service",
            "availableLanguage": "French",
          },
          // Source : profil Trustpilot public de verifiermondevis.fr, relevé
          // le 2026-09-26 (4,7 sur **25** avis ; 24 au 07/09). Valeur répétée
          // dans trois autres fichiers — `TrustpilotSection.tsx`,
          // `index.astro`, `lib/seo/schemaOrg.ts` — qui doivent bouger avec
          // elle. Rien n'est automatique : cf. TODO.md, à centraliser.
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.7",
            "bestRating": "5",
            "worstRating": "1",
            "ratingCount": "25",
            "reviewCount": "25",
          },
        };
      })(),
    )} />

    <!-- 2026-07-19 — SoftwareApplication global retiré du BaseLayout.
         Google Search Console levait « Fiches de marchand » + « Extraits de
         produits » sur toutes les pages du site (100+ pages non-produit),
         parce que l'Offer déclaré partout est interprété comme fiche
         marchand incomplète (availability, priceValidUntil, seller manquants).
         La note aggregée reste portée par l'Organization ci-dessus, ce qui
         suffit pour les rich stars.
         Les vraies pages produit gardent leur propre SoftwareApplication local
         (analyser-devis-travaux, application-gestion-chantier, application-
         suivi-travaux) — c'est là que le rich result est légitime. -->

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://www.verifiermondevis.fr/#website",
      "name": "VerifierMonDevis.fr",
      "url": "https://www.verifiermondevis.fr",
      "description": "Analysez vos devis de travaux en 5 minutes. Score de fiabilité, vérification entreprise, comparaison prix marché.",
      "publisher": { "@id": "https://www.verifiermondevis.fr/#organization" },
      "inLanguage": "fr-FR"
    })} />

    {!noChatWidget && (
      <script src="https://ai.messagingme.app/widget/f236879w135897.js" async="async"></script>
    )}

    <!-- Google Analytics 4 — Consent Mode v2 + 2 streams (VMD + GMC)
         Multi-domaine : détecte le hostname au runtime pour charger le bon
         Measurement ID. La même build sert les 2 domaines (Vercel), donc le
         choix ne peut PAS être fait au build time.
           - verifiermondevis.fr  → G-HJFMR8ST50 (compte Google VMD)
           - gerermonchantier.fr  → G-NE80KQDS6W (compte Google GMC séparé)
         Cookie consent reste `denied` par défaut. À activer via cookie banner
         (option A backlog) ou en passant en mode exemption CNIL (option B).
    -->
    <script is:inline>
      (function() {
        // 2026-08-24 — trafic interne : un navigateur qui a visité /admin* est
        // marqué à vie et n'envoie plus AUCUN hit GA (même les pings cookieless
        // du Consent Mode). Cf. bloc cookie-consent plus bas (même flag).
        if (window.location.pathname.indexOf('/admin') === 0) {
          try { localStorage.setItem('vmd_internal', '1'); } catch (e) {}
        }
        try { if (localStorage.getItem('vmd_internal') === '1') return; } catch (e) {}

        // ── 2026-09-04 (demande Johan) — MESURE D'AUDIENCE FIRST-PARTY ──────
        // GA4 ne compte que les visiteurs qui acceptent les cookies : rapporter
        // nos analyses, comptées à 100 % en base, à ce dénominateur amputé
        // donnerait un funnel faussement flatteur. On compte donc nous-mêmes,
        // sans cookie ni identifiant persistant (empreinte serveur rotative,
        // cf. /api/track/visit). Ce beacon est APRÈS le garde `vmd_internal` :
        // les visites de l'équipe ne sont jamais comptées.
        try {
          // 2026-09-14 — `ref` et `url` servent la PROVENANCE (cf. migration
          // 20260914100000). Le serveur n'en garde que l'hôte du référent et
          // le seul `utm_source` : ni l'URL de référence complète, ni la query
          // string, qui peuvent porter une requête de recherche ou pire.
          // ⚠️ `document.referrer` est indispensable — l'en-tête HTTP Referer
          // du beacon porterait notre propre page, pas la page précédente.
          var corps = JSON.stringify({
            path: window.location.pathname,
            ref: document.referrer || '',
            url: window.location.search || '',
            site: (window.location.hostname || '').indexOf('gerermonchantier') !== -1 ? 'gmc' : 'vmd'
          });
          // sendBeacon survit à la navigation ; fetch en repli sur les vieux
          // navigateurs. keepalive pour ne pas perdre le hit au déchargement.
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/track/visit', new Blob([corps], { type: 'application/json' }));
          } else {
            fetch('/api/track/visit', { method: 'POST', body: corps, keepalive: true,
              headers: { 'Content-Type': 'application/json' } }).catch(function () {});
          }
        } catch (e) { /* la mesure ne doit jamais casser la page */ }

        // Détection domaine côté client (multi-domaine sur même build Vercel)
        var hostname = (window.location.hostname || '').toLowerCase();
        var gaId = hostname.indexOf('gerermonchantier') !== -1
          ? 'G-NE80KQDS6W'   // GMC (compte Google séparé)
          : 'G-HJFMR8ST50';  // VMD (défaut + dev local)

        // Charge gtag.js dynamiquement avec le bon Measurement ID
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
        document.head.appendChild(s);

        // Init gtag + Consent Mode v2
        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }
        gtag('consent', 'default', {
          'analytics_storage': 'denied',
          'ad_storage': 'denied',
          'wait_for_update': 500
        });
        gtag('js', new Date());
        gtag('config', gaId, { 'anonymize_ip': true });

        // Expose globalement pour cookie banner futur
        window.gtag = gtag;
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- Cookie consent banner -->
    <div id="cookie-banner" style="display:none" class="fixed bottom-0 left-0 right-0 z-[9999] px-4 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:p-0">
      <div class="max-w-2xl mx-auto sm:mb-6 bg-card border border-border rounded-xl shadow-lg p-4 sm:p-5">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-4">
          <div class="flex-1 min-w-0">
            <p class="text-sm text-foreground font-medium mb-1">Cookies et confidentialit&eacute;</p>
            <p class="text-xs text-muted-foreground">
              Ce site utilise des cookies techniques (n&eacute;cessaires au fonctionnement) et, avec votre accord, des cookies de mesure d'audience (<strong>Google Analytics</strong>) et de publicit&eacute; (<strong>Meta&nbsp;/&nbsp;Facebook</strong>, <strong>TikTok</strong>) pour mesurer l'audience et am&eacute;liorer nos services. Aucun cookie de tracking n'est d&eacute;pos&eacute; sans votre accord.
              <a href="/confidentialite" class="text-primary hover:underline ml-1">Politique de confidentialit&eacute;</a>
            </p>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <button
              id="cookie-reject"
              class="inline-flex items-center justify-center whitespace-nowrap rounded-md border border-input bg-background hover:bg-accent hover:text-accent-foreground h-11 sm:h-9 px-4 text-sm font-medium"
            >
              Refuser
            </button>
            <button
              id="cookie-accept"
              class="inline-flex items-center justify-center whitespace-nowrap rounded-md bg-primary text-primary-foreground hover:bg-primary/90 h-11 sm:h-9 px-4 text-sm font-medium"
            >
              Accepter
            </button>
          </div>
        </div>
      </div>
    </div>

    {/* 🔴 POPUP NEWSLETTER SUPPRIMÉE LE 2026-09-26 (décision Johan :
         « une sollicitation de plus et qui n'a jamais fonctionné »).

         MESURÉ AVANT DE SUPPRIMER, et le chiffre qui tranche n'est pas
         l'audience : **14 vrais inscrits en 7 mois** (17 lignes dont 3 de nos
         propres comptes), soit deux par mois — mais surtout **RIEN NE LISAIT
         LA TABLE**. Aucun cron, aucune edge function, aucun script :
         `newsletter_subscriptions` n'a qu'un seul écrivain et zéro lecteur.
         Quatorze personnes ont donc donné leur adresse pour une newsletter qui
         n'a jamais été envoyée, et dont le mécanisme d'envoi n'a jamais été
         écrit. C'est la même faute que la case « offres de nos partenaires »
         retirée le 13/09 : on demandait un consentement pour quelque chose qui
         n'existe pas.

         ⚠️ La popup s'ouvrait à l'intention de sortie sur desktop et au bout
         de 30 s sur mobile — donc en plein milieu de la lecture d'une analyse.

         La TABLE et `/api/newsletter` sont CONSERVÉES : 14 adresses réelles y
         dorment, les supprimer effacerait un consentement qu'on n'a pas encore
         honoré. Si une newsletter voit le jour, elles sont là. */}

    <script>
      (function() {
        var consent = localStorage.getItem('cookie-consent');

        // ── 2026-08-24 (demande Johan) — EXCLUSION DU TRAFIC INTERNE ──────
        // Les sessions admin polluaient GA4 (/admin = 12% des vues, 34
        // vues/utilisateur = l'équipe). Méthode sans IP fixe : dès qu'un
        // navigateur visite /admin*, il est marqué "interne" À VIE (flag
        // localStorage) et plus AUCUN tracking (GA/Meta/TikTok/Amplitude via
        // gtag) n'est chargé pour lui, sur tout le site. Pour réactiver le
        // tracking sur un navigateur (test) : localStorage.removeItem('vmd_internal').
        if (window.location.pathname.indexOf('/admin') === 0) {
          try { localStorage.setItem('vmd_internal', '1'); } catch (e) {}
        }
        var isInternal = false;
        try { isInternal = localStorage.getItem('vmd_internal') === '1'; } catch (e) {}
        if (isInternal) return; // ni tracking, ni bannière cookies pour l'équipe

        // Load tracking scripts if previously accepted
        if (consent === 'accepted') {
          loadTrackingScripts();
          return;
        }

        // Don't show banner if already rejected
        if (consent === 'rejected') return;

        // Show banner for new visitors
        var banner = document.getElementById('cookie-banner');
        if (banner) banner.style.display = 'block';

        document.getElementById('cookie-accept')?.addEventListener('click', function() {
          localStorage.setItem('cookie-consent', 'accepted');
          if (banner) banner.style.display = 'none';
          loadTrackingScripts();
        });

        document.getElementById('cookie-reject')?.addEventListener('click', function() {
          localStorage.setItem('cookie-consent', 'rejected');
          if (banner) banner.style.display = 'none';
        });

        function loadTrackingScripts() {
          // === Google Analytics — mise à jour consentement ===
          gtag('consent', 'update', {
            'analytics_storage': 'granted',
            'ad_storage': 'granted'
          });

          // === Meta Pixel (Facebook) — ID 1006152355233216 (VMD + GMC, layout partagé) ===
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window,document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', '1006152355233216');
          fbq('track', 'PageView');

          // === TikTok Pixel — ID D902V4RC77UB3EFMQVB0 (VMD + GMC, layout partagé) ===
          !function (w, d, t) {
            w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"];ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e};ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js",o=n&&n.partner;ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=r;ttq._t=ttq._t||{};ttq._t[e]=+new Date;ttq._o=ttq._o||{};ttq._o[e]=n||{};n=document.createElement("script");n.type="text/javascript";n.async=!0;n.src=r+"?sdkid="+e+"&lib="+t;e=document.getElementsByTagName("script")[0];e.parentNode.insertBefore(n,e)};
            ttq.load('D902V4RC77UB3EFMQVB0');
            ttq.page();
          }(window, document, 'ttq');
        }
      })();
    </script>

    <!-- Amplitude Analytics -->
    <script>
      import { initAmplitude, trackPageView } from '@/lib/integrations/amplitude';
      // Le <script> Astro (sans is:inline) est déféré par Vite — exécuté après le DOM.
      initAmplitude();
      trackPageView();
    </script>
  </body>
</html>
