---
// Multi-domaine : SSR pour permettre au middleware (src/middleware.ts) de rewrite
// vers /gmc-home quand Host = (www.)gerermonchantier.fr.
// Sur verifiermondevis.fr, comportement inchangé — page rendue côté serveur.
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import AstroHeader from '@/components/astro/Header.astro';
import AstroFooter from '@/components/astro/Footer.astro';
import DisclaimerSection from '@/components/landing/DisclaimerSection';
import CTASection from '@/components/landing/CTASection';
import TrustpilotSection from '@/components/landing/TrustpilotSection';
import BlogTeaser from '@/components/landing/BlogTeaser';
// 2026-09-08 (retour Johan) — « Comment ça marche ? » + « Ce que vous obtenez »
// fusionnés en un seul bloc : huit boîtes blanches quasi identiques dans deux
// bandes grises, qui se répétaient l'une l'autre. Cf. DuDevisAuVerdict.tsx.
// Sans directive client : le composant n'a ni état ni gestionnaire, donc HTML
// rendu au build et zéro JS envoyé.
import DuDevisAuVerdict from '@/components/landing/DuDevisAuVerdict';
// 2026-09-10 — la taille du catalogue est une PROMESSE CHIFFRÉE affichée au
// public : elle était écrite en dur ici (919) et se périmait à chaque migration
// du catalogue. Elle vient désormais de la source unique, régénérée depuis
// `market_prices` (cf. CLAUDE.md § « Une seule valorisation dans tout le site »).
// 2026-09-14 — `ANALYSES_TOTAL` et `poste` rejoignent l'import : le hero
// affiche le nombre de devis analysés et les fourchettes de son exemple, et
// les deux doivent venir du fichier généré. Un exemple dont les fourchettes
// sont écrites à la main devient faux dès que le catalogue bouge.
import { CATALOGUE_TAILLE, ANALYSES_TOTAL, poste } from '@/lib/prix/reference';
// 2026-09-23 — même raison, appliquée aux compteurs de l'Observatoire : les
// sept nombres écrits en dur dans cette page étaient TOUS faux (isolation
// annonçait 66 devis pour 38 réels). Ils viennent des JSON publiés, régénérés
// chaque lundi. ⚠️ Import statique et non `fs` : cette page est en
// `prerender = false`, et le runtime serverless n'embarque pas `src/`.
import { CARTES_OBSERVATOIRE } from '@/lib/observatoire/cartesAccueil';
import SimulateurAidesCard from '@/components/homepage/SimulateurAidesCard';
import SocialProofTicker from '@/components/homepage/SocialProofTicker';

/**
 * Les quatre guides de la section « Nos guides travaux » (design 2026-09-23).
 *
 * ⚠️ LES LIBELLÉS ET LES URL SONT LA RAISON D'ÊTRE DE LA SECTION. Elle existe
 * depuis le 04/09 pour une raison de maillage : la page « comparer » ne
 * recevait aucun lien de l'accueil et Google choisissait /verifier ou
 * /analyser sur les requêtes de comparaison. **L'ancre est le titre exact de
 * la requête visée** — la refonte visuelle ne doit RIEN y changer.
 *
 * ⚠️ `largeur`/`hauteur` = les dimensions RÉELLES du fichier, pas celles de
 * l'affichage. Elles réservent la place avant le chargement (pas de saut de
 * mise en page) ; les mentir déplacerait le contenu au chargement.
 */
const GUIDES_TRAVAUX = [
  {
    href: '/comparer-devis-travaux',
    titre: 'Comparer des devis travaux',
    sousTitre: 'Poste par poste, prix unitaires',
    image: '/images/guides/comparer.webp',
    largeur: 768, hauteur: 768,
  },
  {
    href: '/verifier-devis-travaux',
    titre: 'Vérifier un devis travaux',
    sousTitre: 'Méthode complète en 5 étapes',
    image: '/images/guides/verifier.webp',
    largeur: 626, hauteur: 417,
  },
  {
    href: '/prix-travaux-maison',
    titre: 'Prix des travaux maison',
    sousTitre: 'Tarifs 2026 par type de travaux',
    image: '/images/guides/prix.webp',
    largeur: 1080, hauteur: 476,
  },
  {
    href: '/choisir-artisan-travaux',
    titre: 'Choisir un artisan fiable',
    sousTitre: '6 vérifications essentielles',
    image: '/images/guides/artisan.webp',
    largeur: 626, hauteur: 417,
    // Demandé par le handoff : recadré au centre, le casque sort du cadre et
    // le visage est coupé. On remonte le point d'ancrage.
    cadrage: 'object-[center_20%]',
  },
];
// HeroSection inliné ci-dessous pour modification des textes uniquement

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "VerifierMonDevis.fr",
  "description": "Service gratuit de vérification et d'analyse de devis d'artisans pour les particuliers. Score de fiabilité, vérification SIRET, comparaison prix marché.",
  "url": "https://www.verifiermondevis.fr",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "inLanguage": "fr-FR",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR",
    "description": "Analyse gratuite de devis artisan"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.7",
    "reviewCount": "24",
    "bestRating": "5",
    "worstRating": "1"
  },
  "publisher": {
    "@id": "https://www.verifiermondevis.fr/#organization"
  },
  // sameAs (2026-06-09) — comptes sociaux officiels VMD. Aide Google à
  // associer le domaine aux comptes pour le Knowledge Panel + boost E-E-A-T.
  "sameAs": [
    "https://www.instagram.com/verifiermondevis/",
    "https://www.facebook.com/profile.php?id=61590412092738"
  ]
};
---

<BaseLayout
  title="Votre devis est-il trop cher… ou risqué ? | VerifierMonDevis.fr"
  description={`Analysez votre devis travaux : surcoût poste par poste sur ${CATALOGUE_TAILLE} références de prix, entreprise vérifiée (radiation, santé financière), clauses abusives détectées. Sans commission d'artisan.`}
  canonical="https://www.verifiermondevis.fr/"
  jsonLd={jsonLd}
  preloadImage={{ href: '/images/hero-devis.webp', media: '(min-width: 1024px)' }}
>
  <div class="min-h-screen flex flex-col">
    <AstroHeader />
    <main class="flex-1">

      {/* ══ HERO ══ — refonte 2026-09-14 (décision Johan)

          POURQUOI. Mesuré le 14/09 sur 11 jours : 806 visiteurs voient
          l'accueil, 31 cliquent (3,8 %), et 90 % de TOUS les visiteurs ne
          voient qu'une seule page. Le hero n'est pas une accroche — c'est
          tout le site pour la quasi-totalité du trafic. Tout ce qui est en
          aval convertit déjà entre 68 et 100 %.

          ⚠️ LE DÉFAUT N'ÉTAIT PAS LE VOLUME DE TEXTE. Les pages qui
          convertissent le mieux (`/analyser-devis-travaux`, 62 %) en ont
          davantage. Le défaut était que TOUT AVAIT LE MÊME POIDS : quatre
          arguments et un pavé « expert » de quatre lignes dans la même
          grise. Même défaut que les huit boîtes blanches identiques
          corrigées le 08/09 au milieu de la page. On resserre la
          hiérarchie, on ne supprime pas la substance.

          ⚠️ ET SUR MOBILE, L'ANCIENNE COLONNE VISUELLE ÉTAIT `hidden
          lg:block` : il n'y avait AUCUNE image, seulement le mur de texte.
          Le carrousel est donc placé juste après le bouton sur mobile, via
          des zones de grille — c'est là que la preuve doit tomber.

          ⚠️ CONTENU RENDU EN HTML AU BUILD. Le JavaScript ne sert QU'À
          faire tourner les cartes : les quatre sont dans le document. Ne
          jamais déplacer ce bloc dans une île `client:only` — le H1 et le
          texte disparaîtraient du HTML servi (règle du 07/09). */}
      <section class="hero-gradient vmd-hero vmd-hero-photo">
        <div class="container vmd-hero-grid">

          {/* ── Zone haute : la thèse ─────────────────────────────────── */}
          <div class="vh-top">
            <p class="vh-eyebrow">
              <b>{ANALYSES_TOTAL.toLocaleString('fr-FR')}</b> devis analysés
              <span class="vh-sep" aria-hidden="true"></span>
              <b>{CATALOGUE_TAILLE.toLocaleString('fr-FR')}</b> références de prix
            </p>

            <h1 class="vh-title">
              Votre devis est-il trop cher…<br />
              ou <span class="vh-mark">risqué&nbsp;?<svg viewBox="0 0 200 10" fill="none" aria-hidden="true"><path d="M2 7C48 3 108 2 198 5" stroke="currentColor" class="text-score-green" stroke-width="4.5" stroke-linecap="round" /></svg></span>
            </h1>

            <p class="vh-lede">
              Chaque ligne comparée au marché, l'entreprise vérifiée dans les registres,
              les clauses passées au crible. Vous repartez avec un verdict — et les
              arguments exacts pour négocier.
            </p>

            <div class="vh-actions">
              <a href="/nouvelle-analyse" class="vh-btn vh-btn-primary">
                Savoir si je peux signer
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              {/* 2026-09-14 — pointe vers /exemple-analyse, une VRAIE page
                  (première version : une ancre vers le bas de l'accueil,
                  jugée insuffisante par Johan — il voulait une page démo).
                  ⚠️ LE LIBELLÉ NE DIT PAS « RÉELLE », ET C'EST DÉLIBÉRÉ.
                  Le devis de la page démo est FICTIF — nous l'avons écrit.
                  Publier l'analyse d'un vrai client est exclu : un devis
                  appartient aussi à l'artisan qui l'a émis, tiers qui n'a
                  jamais consenti (précédent du 10/09). Les fourchettes et les
                  règles, elles, sont les vraies. */}
              <a href="/exemple-analyse" class="vh-btn vh-btn-ghost">Voir un exemple d'analyse</a>
            </div>

            <p class="vh-micro">Création de compte en 30 secondes, puis analyse immédiate — gratuit.</p>
          </div>

          {/* ── Zone scène : nos écrans de sortie ─────────────────────── */}
          <div class="vh-stage" id="apercu">
            <div class="vh-tabs" role="tablist" aria-label="Ce que contient une analyse">
              <button type="button" class="vh-tab" role="tab" aria-selected="true" aria-controls="vh-p0" id="vh-t0" data-go="0">Prix</button>
              <button type="button" class="vh-tab" role="tab" aria-selected="false" aria-controls="vh-p1" id="vh-t1" data-go="1" tabindex="-1">Entreprise</button>
              <button type="button" class="vh-tab" role="tab" aria-selected="false" aria-controls="vh-p2" id="vh-t2" data-go="2" tabindex="-1">Clauses</button>
              <button type="button" class="vh-tab" role="tab" aria-selected="false" aria-controls="vh-p3" id="vh-t3" data-go="3" tabindex="-1">Ce qu'on ne dit pas</button>
            </div>

            <div class="vh-rail vh-run" id="vh-rail" aria-hidden="true"><i></i></div>

            <div class="vh-deck">

              {/* 1 · PRIX — les fourchettes viennent du RÉFÉRENTIEL, jamais
                   écrites à la main : si le catalogue bouge, l'exemple ne
                   devient pas faux (même règle que DuDevisAuVerdict). */}
              <article class="vh-card" data-active="true" role="tabpanel" id="vh-p0" aria-labelledby="vh-t0">
                <div class="vh-card-head">
                  <span class="vh-kicker">Verdict · rénovation salle de bains</span>
                  <span class="vh-pill vh-orange">À négocier</span>
                </div>
                <p class="vh-verdict">Deux postes dépassent les fourchettes du marché.</p>
                <p class="vh-because">Le reste du devis est cohérent. Nous ne chiffrons que ce que nous pouvons nommer.</p>

                <div class="vh-row">
                  <div class="vh-row-main">
                    <div class="vh-row-label">{poste('cloison_placo').libelle}</div>
                    <div class="vh-row-sub">22 m² · 128 €/m² — marché {poste('cloison_placo').min} à {poste('cloison_placo').max} €/m²</div>
                  </div>
                  <div class="vh-row-val vh-up">+&thinsp;726&nbsp;€</div>
                </div>
                <div class="vh-row">
                  <div class="vh-row-main">
                    <div class="vh-row-label">{poste('carrelage_fourni_pose').libelle}</div>
                    <div class="vh-row-sub">14 m² · 118 €/m² — marché {poste('carrelage_fourni_pose').min} à {poste('carrelage_fourni_pose').max} €/m²</div>
                  </div>
                  <div class="vh-row-val vh-up">+&thinsp;336&nbsp;€</div>
                </div>
                <div class="vh-row">
                  <div class="vh-row-main">
                    <div class="vh-row-label">{poste('peinture_murs_plafonds').libelle}</div>
                    <div class="vh-row-sub">38 m² · 42 €/m² — marché {poste('peinture_murs_plafonds').min} à {poste('peinture_murs_plafonds').max} €/m²</div>
                  </div>
                  <div class="vh-row-val vh-ok">dans la norme</div>
                </div>

                <div class="vh-total">
                  <span>Écart chiffré sur les postes nommés</span>
                  <b>1&thinsp;062&nbsp;€</b>
                </div>
              </article>

              {/* 2 · ENTREPRISE */}
              <article class="vh-card" role="tabpanel" id="vh-p1" aria-labelledby="vh-t1" hidden>
                <div class="vh-card-head">
                  <span class="vh-kicker">Entreprise · SIREN 812 456 903</span>
                  <span class="vh-pill vh-green">Active</span>
                </div>
                <p class="vh-verdict">SARL BATI CONFORT</p>
                <p class="vh-because">Vérifiée dans les registres publics au moment de l'analyse.</p>

                <div class="vh-kv">
                  <div class="vh-kv-k">État administratif<i>Aucune procédure collective</i></div>
                  <span class="vh-pill vh-green">Active</span>
                </div>
                <div class="vh-kv">
                  <div class="vh-kv-k">Immatriculation<i>9 ans d'ancienneté</i></div>
                  <span class="vh-pill vh-green">Solide</span>
                </div>
                <div class="vh-kv">
                  <div class="vh-kv-k">Certification RGE<i>QualiBat 7131 — valide jusqu'au 31/12/2026</i></div>
                  <span class="vh-pill vh-green">Vérifiée</span>
                </div>
                <div class="vh-kv">
                  <div class="vh-kv-k">Assurance décennale<i>Non mentionnée sur le devis</i></div>
                  <span class="vh-pill vh-amber">À réclamer</span>
                </div>
                <div class="vh-kv">
                  <div class="vh-kv-k">Comptes annuels<i>Non accessibles publiquement</i></div>
                  <span class="vh-pill vh-slate">Sans avis</span>
                </div>
              </article>

              {/* 3 · CLAUSES */}
              <article class="vh-card" role="tabpanel" id="vh-p2" aria-labelledby="vh-t2" hidden>
                <div class="vh-card-head">
                  <span class="vh-kicker">Clauses · 2 détectées</span>
                  <span class="vh-pill vh-red">1 illégale</span>
                </div>
                <p class="vh-verdict">Deux clauses à faire retirer avant signature.</p>
                <p class="vh-because">Citées mot pour mot depuis le devis — jamais reformulées.</p>

                <p class="vh-quote">« Tout devis non signé dans les 15 jours sera facturé 90 € au titre de l'étude technique. »</p>
                <p class="vh-note vh-note-gap">
                  <b>Illégale sans accord préalable écrit</b> — article L.111-1 du Code de la
                  consommation. Un devis est gratuit, sauf si son coût vous a été annoncé avant.
                </p>

                <p class="vh-quote vh-quote-amber">« Acompte de 50 % à la commande, solde à la livraison du matériel. »</p>
                <p class="vh-note">
                  <b>Au-dessus de l'usage</b> — 30 % est la pratique courante. Ça ne change pas
                  le prix, seulement le moment où vous payez : demandez un échelonnement.
                </p>
              </article>

              {/* 4 · CE QU'ON NE DIT PAS — la carte qui nous distingue.
                   Aucun concurrent n'écrit qu'il ne sait pas. */}
              <article class="vh-card" role="tabpanel" id="vh-p3" aria-labelledby="vh-t3" hidden>
                <div class="vh-card-head">
                  <span class="vh-kicker">Honnêteté · 3 postes sur 11</span>
                  <span class="vh-pill vh-slate">Prix non vérifiable</span>
                </div>
                <p class="vh-verdict">Sur trois postes, nous ne pouvons pas nous prononcer.</p>
                <p class="vh-because">Ni bon marché, ni cher : nous n'avons aucune référence que nous puissions opposer à l'artisan.</p>

                <div class="vh-row">
                  <div class="vh-row-main">
                    <div class="vh-row-label">Meuble vasque sur mesure, chêne massif</div>
                    <div class="vh-row-sub">1 u · 2 450 € — aucun tarif de référence</div>
                  </div>
                  <div class="vh-row-val">—</div>
                </div>
                <div class="vh-row">
                  <div class="vh-row-main">
                    <div class="vh-row-label">Reprise d'étanchéité sous receveur</div>
                    <div class="vh-row-sub">forfait · 680 € — périmètre propre au chantier</div>
                  </div>
                  <div class="vh-row-val">—</div>
                </div>
                <div class="vh-row">
                  <div class="vh-row-main">
                    <div class="vh-row-label">Évacuation en déchetterie agréée</div>
                    <div class="vh-row-sub">forfait · 210 € — varie avec la distance</div>
                  </div>
                  <div class="vh-row-val">—</div>
                </div>

                <p class="vh-note vh-note-top">
                  <b>Un second devis est le seul comparatif réel sur ces postes.</b>
                  Nous préférons le dire plutôt que d'inventer une fourchette que vous
                  iriez défendre devant un artisan.
                </p>
              </article>

            </div>

            {/* ⚠️ Cette légende dit ce qui est VRAI : l'exemple est fabriqué.
                Les fourchettes, elles, viennent du référentiel. Ne pas écrire
                « sortie réelle de l'outil » tant que le devis d'exemple n'est
                pas passé dans le pipeline. */}
            <p class="vh-cap">Exemple illustratif — fourchettes issues de notre référentiel de {CATALOGUE_TAILLE.toLocaleString('fr-FR')} prix.</p>
          </div>

          {/* ── Zone basse : les preuves ──────────────────────────────── */}
          <div class="vh-bottom">
            <ul class="vh-proofs">
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#4ADE80" /><path d="M7 12l3 3 7-7" stroke="#0B2A6B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <p><b>Surcoût chiffré, poste par poste</b> <span>— contre {CATALOGUE_TAILLE.toLocaleString('fr-FR')} références de prix sourcées</span></p>
              </li>
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#4ADE80" /><path d="M7 12l3 3 7-7" stroke="#0B2A6B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <p><b>Entreprise vérifiée</b> <span>— radiation, procédure collective, santé financière, certifications RGE contrôlées dans les registres</span></p>
              </li>
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#4ADE80" /><path d="M7 12l3 3 7-7" stroke="#0B2A6B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <p><b>Clauses abusives détectées</b> <span>— acompte excessif, IBAN suspect, rétractation refusée</span></p>
              </li>
              {/* La relecture humaine tenait dans un encadré de quatre lignes.
                  Elle reste — en une ligne, au même niveau que le reste. */}
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#4ADE80" /><path d="M7 12l3 3 7-7" stroke="#0B2A6B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <p><b>Relu par un expert</b> <span>— et tant qu'il n'a pas tranché, aucun montant n'est affiché</span></p>
              </li>
            </ul>

            {/* La ligne signature : seule promesse que les comparateurs et les
                plateformes de mise en relation ne peuvent pas copier — ils
                vivent de la commission ou de la revente de lead. */}
            <p class="vh-pledge">Sans commission d'artisan. <b>Sans revente de lead.</b></p>

            <p class="vh-more">
              <a href="/comprendre-score">Voir en détail ce qui est analysé</a>
            </p>
          </div>

        </div>
      </section>

<style>
  /* ── Hero 2026-09-14 ──────────────────────────────────────────────────
     Styles scopés par Astro. Les couleurs viennent des tokens de
     `src/index.css` (--score-green / --score-orange / --score-red) ou du
     blanc translucide sur le dégradé de marque — aucune teinte inventée. */
  /* ⚠️ 2026-09-14 — PAS DE TRAME DE FOND ICI.
     Une première version posait des réglures horizontales en
     `repeating-linear-gradient` (rgba(255,255,255,.05) tous les 34 px) pour
     évoquer le papier d'un devis. À l'écran elles se lisent comme des
     lignes blanches parasites sur le dégradé, pas comme une texture —
     retiré sur retour Johan. Le fond reste le dégradé de marque, net. */
  .vmd-hero { position: relative; overflow: hidden; }

  /* ── Fond photo du hero (design validé 2026-09-23) ───────────────────
     Une photo réelle remplace le dégradé uni, avec un voile navy en sept
     arrêts : opaque à gauche pour que le texte reste lisible, presque
     transparent au centre pour révéler le sujet, refermé à droite derrière
     la carte.

     🔴 RIEN N'EST TÉLÉCHARGÉ SOUS 1024 px, ET C'EST UNE DÉCISION DE VITESSE,
     PAS DE GOÛT. Mesuré avant ce chantier (Lighthouse, mobile 4G bridée) :
     **score 80, LCP 4,6 s** — déjà au-dessus du seuil « bon » de 2,5 s.
     Poser une image de plus sur ce chemin aurait aggravé la seule page que
     voient neuf visiteurs sur dix. Le handoff l'autorise explicitement
     (« repasser à un fond navy uni si la photo écrase trop le texte en
     mobile — à arbitrer selon rendu réel »).

     ⚠️ LA MÉDIA QUERY EST CE QUI GARANTIT LE ZÉRO OCTET. Un `<img>` masqué
     par `hidden lg:block` reste téléchargé par certains navigateurs ; une
     `background-image` déclarée à l'intérieur d'un `@media` non satisfait
     n'est JAMAIS demandée. Le `<link rel="preload">` du head porte le même
     `media`, donc il ne se déclenche pas non plus.

     ⚠️ Le dégradé de marque (`.hero-gradient`) RESTE sous la photo : c'est
     lui qu'on voit sur mobile, et il sert de fond pendant que la photo
     charge sur desktop — donc aucun aplat noir, aucun saut. */
  @media (min-width: 1024px) {
    .vmd-hero-photo::before {
      content: "";
      position: absolute;
      inset: 0;
