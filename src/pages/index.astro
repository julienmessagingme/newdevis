<script>
  // Rotation des cartes du hero. Le CONTENU est déjà dans le HTML : ce script
  // ne fait que changer laquelle est visible. Si le JS ne charge pas, la
  // première carte reste affichée et le reste du document est intact.
  (() => {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.vh-tab'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.vh-card'));
    const rail = document.getElementById('vh-rail');
    const stage = document.querySelector<HTMLElement>('.vh-stage');
    if (tabs.length === 0 || cards.length === 0 || !rail || !stage) return;

    const calme = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let minuteur: number | null = null;

    const montrer = (n: number) => {
      i = (n + cards.length) % cards.length;
      cards.forEach((c, k) => {
        const actif = k === i;
        c.toggleAttribute('hidden', !actif);
        c.setAttribute('data-active', actif ? 'true' : 'false');
      });
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', k === i ? 'true' : 'false');
        t.tabIndex = k === i ? 0 : -1;
      });
      // Retirer puis remettre la classe force le navigateur à rejouer
      // l'animation de la barre de progression.
      rail.classList.remove('vh-run');
      void rail.offsetWidth;
      if (!calme) rail.classList.add('vh-run');
    };

    const stop = () => { if (minuteur !== null) { clearInterval(minuteur); minuteur = null; } };
    const jouer = () => { if (calme) return; stop(); minuteur = window.setInterval(() => montrer(i + 1), 5400); };

    tabs.forEach((t) => t.addEventListener('click', () => { montrer(Number(t.dataset.go)); jouer(); }));

    // Le carrousel ne doit jamais bouger sous les yeux de quelqu'un qui lit.
    stage.addEventListener('mouseenter', stop);
    stage.addEventListener('mouseleave', jouer);
    stage.addEventListener('focusin', stop);
    stage.addEventListener('focusout', jouer);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : jouer()));

    document.querySelector('.vh-tabs')?.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== 'ArrowRight' && ev.key !== 'ArrowLeft') return;
      ev.preventDefault();
      montrer(i + (ev.key === 'ArrowRight' ? 1 : -1));
      tabs[i].focus();
      jouer();
    });

    montrer(0);
    jouer();
  })();
</script>

