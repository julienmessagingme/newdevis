---
// Multi-domaine : SSR pour permettre au middleware (src/middleware.ts) de rewrite
// vers /gmc-home quand Host = (www.)gerermonchantier.fr.
// Sur verifiermondevis.fr, comportement inchangé — page rendue côté serveur.
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import AstroHeader from '@/components/astro/Header.astro';
import AstroFooter from '@/components/astro/Footer.astro';
import DisclaimerSection from '@/components/landing/DisclaimerSection';
import CTASection from '@/components/landing/CTASection';
import TrustpilotSection from '@/components/landing/TrustpilotSection';
import BlogTeaser from '@/components/landing/BlogTeaser';
// 2026-09-08 (retour Johan) — « Comment ça marche ? » + « Ce que vous obtenez »
// fusionnés en un seul bloc : huit boîtes blanches quasi identiques dans deux
// bandes grises, qui se répétaient l'une l'autre. Cf. DuDevisAuVerdict.tsx.
// Sans directive client : le composant n'a ni état ni gestionnaire, donc HTML
// rendu au build et zéro JS envoyé.
import DuDevisAuVerdict from '@/components/landing/DuDevisAuVerdict';
// 2026-09-10 — la taille du catalogue est une PROMESSE CHIFFRÉE affichée au
// public : elle était écrite en dur ici (919) et se périmait à chaque migration
// du catalogue. Elle vient désormais de la source unique, régénérée depuis
// `market_prices` (cf. CLAUDE.md § « Une seule valorisation dans tout le site »).
// 2026-09-14 — `ANALYSES_TOTAL` et `poste` rejoignent l'import : le hero
// affiche le nombre de devis analysés et les fourchettes de son exemple, et
// les deux doivent venir du fichier généré. Un exemple dont les fourchettes
// sont écrites à la main devient faux dès que le catalogue bouge.
import { CATALOGUE_TAILLE, ANALYSES_TOTAL, poste } from '@/lib/prix/reference';
// 2026-09-23 — même raison, appliquée aux compteurs de l'Observatoire : les
// sept nombres écrits en dur dans cette page étaient TOUS faux (isolation
// annonçait 66 devis pour 38 réels). Ils viennent des JSON publiés, régénérés
// chaque lundi. ⚠️ Import statique et non `fs` : cette page est en
// `prerender = false`, et le runtime serverless n'embarque pas `src/`.
import { CARTES_OBSERVATOIRE } from '@/lib/observatoire/cartesAccueil';
import SimulateurAidesCard from '@/components/homepage/SimulateurAidesCard';

/**
 * Les quatre guides de la section « Nos guides travaux » (design 2026-09-23).
 *
 * ⚠️ LES LIBELLÉS ET LES URL SONT LA RAISON D'ÊTRE DE LA SECTION. Elle existe
 * depuis le 04/09 pour une raison de maillage : la page « comparer » ne
 * recevait aucun lien de l'accueil et Google choisissait /verifier ou
 * /analyser sur les requêtes de comparaison. **L'ancre est le titre exact de
 * la requête visée** — la refonte visuelle ne doit RIEN y changer.
 *
 * ⚠️ `largeur`/`hauteur` = les dimensions RÉELLES du fichier, pas celles de
 * l'affichage. Elles réservent la place avant le chargement (pas de saut de
 * mise en page) ; les mentir déplacerait le contenu au chargement.
 */
const GUIDES_TRAVAUX = [
  {
    href: '/comparer-devis-travaux',
    titre: 'Comparer des devis travaux',
    sousTitre: 'Poste par poste, prix unitaires',
    image: '/images/guides/comparer.webp',
    largeur: 768, hauteur: 768,
  },
  {
    href: '/verifier-devis-travaux',
    titre: 'Vérifier un devis travaux',
    sousTitre: 'Méthode complète en 5 étapes',
    image: '/images/guides/verifier.webp',
    largeur: 626, hauteur: 417,
  },
  {
    href: '/prix-travaux-maison',
    titre: 'Prix des travaux maison',
    sousTitre: 'Tarifs 2026 par type de travaux',
    image: '/images/guides/prix.webp',
    largeur: 1080, hauteur: 476,
  },
  {
    href: '/choisir-artisan-travaux',
    titre: 'Choisir un artisan fiable',
    sousTitre: '6 vérifications essentielles',
    image: '/images/guides/artisan.webp',
    largeur: 626, hauteur: 417,
    // Demandé par le handoff : recadré au centre, le casque sort du cadre et
    // le visage est coupé. On remonte le point d'ancrage.
    cadrage: 'object-[center_20%]',
  },
];
// HeroSection inliné ci-dessous pour modification des textes uniquement

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "VerifierMonDevis.fr",
  "description": "Service gratuit de vérification et d'analyse de devis d'artisans pour les particuliers. Score de fiabilité, vérification SIRET, comparaison prix marché.",
  "url": "https://www.verifiermondevis.fr",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "inLanguage": "fr-FR",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR",
    "description": "Analyse gratuite de devis artisan"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.7",
    "reviewCount": "24",
    "bestRating": "5",
    "worstRating": "1"
  },
  "publisher": {
    "@id": "https://www.verifiermondevis.fr/#organization"
  },
  // sameAs (2026-06-09) — comptes sociaux officiels VMD. Aide Google à
  // associer le domaine aux comptes pour le Knowledge Panel + boost E-E-A-T.
  "sameAs": [
    "https://www.instagram.com/verifiermondevis/",
    "https://www.facebook.com/profile.php?id=61590412092738"
  ]
};
---

<BaseLayout
  title="Votre devis est-il trop cher… ou risqué ? | VerifierMonDevis.fr"
  description={`Analysez votre devis travaux : surcoût poste par poste sur ${CATALOGUE_TAILLE} références de prix, entreprise vérifiée (radiation, santé financière), clauses abusives détectées. Sans commission d'artisan.`}
  canonical="https://www.verifiermondevis.fr/"
  jsonLd={jsonLd}
>
  <div class="min-h-screen flex flex-col">
    <AstroHeader />
    <main class="flex-1">

      {/* ══ HERO ══ — refonte 2026-09-14 (décision Johan)

          POURQUOI. Mesuré le 14/09 sur 11 jours : 806 visiteurs voient
          l'accueil, 31 cliquent (3,8 %), et 90 % de TOUS les visiteurs ne
          voient qu'une seule page. Le hero n'est pas une accroche — c'est
          tout le site pour la quasi-totalité du trafic. Tout ce qui est en
          aval convertit déjà entre 68 et 100 %.

          ⚠️ LE DÉFAUT N'ÉTAIT PAS LE VOLUME DE TEXTE. Les pages qui
          convertissent le mieux (`/analyser-devis-travaux`, 62 %) en ont
          davantage. Le défaut était que TOUT AVAIT LE MÊME POIDS : quatre
          arguments et un pavé « expert » de quatre lignes dans la même
          grise. Même défaut que les huit boîtes blanches identiques
          corrigées le 08/09 au milieu de la page. On resserre la
          hiérarchie, on ne supprime pas la substance.

          ⚠️ ET SUR MOBILE, L'ANCIENNE COLONNE VISUELLE ÉTAIT `hidden
          lg:block` : il n'y avait AUCUNE image, seulement le mur de texte.
          Le carrousel est donc placé juste après le bouton sur mobile, via
          des zones de grille — c'est là que la preuve doit tomber.

          ⚠️ CONTENU RENDU EN HTML AU BUILD, sans aucune île `client:only` —
          le H1 et le texte disparaîtraient du HTML servi (règle du 07/09).

          ══ RÉVISION 2026-09-25 — PHOTO « POIGNÉE DE MAIN » (handoff validé)

          🔴 LE CARROUSEL EST SUPPRIMÉ, ET CE N'EST PAS GRATUIT. Il tournait
          tout seul — mesuré : le contenu du premier écran changeait en 5 s
          sans aucune interaction, ce qui fait perdre sa ligne au lecteur de
          la colonne fixe. C'est le reproche le plus solide de la relecture
          UX du 25/09, et il ne se corrige qu'en retirant le mouvement.
          ⚠️ MAIS on y perd la carte « Ce qu'on ne dit pas », documentée le
          14/09 comme « le seul actif qu'un concurrent ne peut pas imiter ».
          La perte est BORNÉE, pas nulle : la sortie du produit reste montrée
          un écran plus bas (`DuDevisAuVerdict`) et en entier sur
          `/exemple-analyse`, où pointe le bouton secondaire.

          ⚠️ ET LE HERO DU 14/09 A COÏNCIDÉ AVEC UN DOUBLEMENT DE LA
          CONVERSION (3,9 % → 7,7 %, parcours réel même-visiteur). Non
          attribuable — 31 conversions de chaque côté, et le trafic s'est
          effondré d'un facteur 5 le 19/09 — mais à savoir avant de conclure
          que ce remplacement est un progrès. À remesurer.

          🔴 LA PHOTO EST UN `<img>`, PLUS UNE `background-image`, et le
          preload a été RETIRÉ. Le preload du 23/09 existait parce que
          l'image vivait dans le CSS : elle n'était découverte qu'après
          l'analyse de la feuille de style. Un `<img fetchpriority="high"`
          placé en tête de `<main>` est découvert par le pré-parseur avant
          même le CSS — le preload n'avancerait rien et interdirait le
          `<picture>` (deux cadrages, donc deux fichiers, qu'un seul
          `preloadImage` ne sait pas décrire). */}
      <section class="hero-gradient vmd-hero vmd-hero-poignee">

        {/* ⚠️ DEUX CADRAGES, DONC `<picture>` ET NON `srcset` : le desktop
            reçoit le PORTRAIT d'origine (896×1200, il occupe une colonne
            haute), le mobile une BANDE 780×600 recadrée à 40 % de la
            hauteur — les trois visages et la poignée de main y sont, ce
            qu'un simple redimensionnement ne garantit pas. `srcset` suppose
            la même image à deux résolutions ; ce n'est pas le cas ici.
            ⚠️ 45 Ko sur mobile contre 118 en desktop : le mobile est déjà à
            4,8 s de LCP (mesuré le 23/09), lui envoyer le portrait entier
            aurait coûté 73 Ko pour un bandeau de 300 px de haut. */}
        <div class="vh-photo-wrap">
          <picture>
            {/* ⚠️ LA BASCULE EST À 768, PAS 1024, ET C'EST MESURÉ : dès 768 px
                la photo passe en COLONNE (450×1005 à 900 px de large). Servir
                la bande 780×600 dans une fente portrait l'agrandit d'un
                facteur 1,7 en hauteur et la recadre au mauvais endroit —
                vérifié à l'écran avant correction. */}
            <source media="(min-width: 768px)" srcset="/images/hero-poignee.webp" width="896" height="1200" />
            <img
              class="vh-photo"
              src="/images/hero-poignee-mobile.webp"
              width="780" height="340"
              fetchpriority="high"
              decoding="async"
              alt="Un couple serre la main de son artisan devant une maison en rénovation"
            />
          </picture>
          {/* 🔴 LA PHOTO EST MASQUÉE, PAS RECOUVERTE D'UN APLAT. Le handoff
              donne un voile `#0B2A6B` — un hexadécimal qui n'est PAS notre
              token (`--hero-gradient` va de #1B4498 à #1A3366) et qui se
              verrait comme une bande d'une autre couleur au raccord. Le
              `mask-image` rend le bord gauche TRANSPARENT : c'est le vrai
              dégradé de marque qui apparaît dessous, donc le raccord est
              exact par construction et le reste juste si le token change.
              ⚠️ Si le navigateur ignore le masque, il ne se passe rien de
              grave : la photo n'atteint jamais la colonne de texte, elle
              aurait seulement un bord net au lieu d'un fondu. */}
          <span class="vh-photo-veil" aria-hidden="true"></span>

        </div>

        <div class="container vmd-hero-grid">

          {/* ══ HERO ÉPURÉ — 2026-09-25, décision Johan ══════════════════════

              CE QU'IL RESTE : le titre, le bouton, la micro-copie. Rien d'autre.
              Mesuré : le hero passe de **47 à 6 mots**, sa hauteur de 896 à
              ~490 px, et le CTA de 55 % à 41 % de l'écran en desktop.

              🔴 CE QUI A ÉTÉ DÉPLACÉ, PAS SUPPRIMÉ — et la distinction est
              tout. Le badge des compteurs, les quatre preuves et la signature
              « sans commission / sans revente de lead » vivent désormais dans
              `DuDevisAuVerdict`, un écran plus bas. **Rien n'est perdu** : la
              raison du déplacement est que les trois mêmes vérifications
              étaient dites TROIS FOIS (hero → étape 2 → carte d'exemple), et
              que seule la carte les PROUVE. Les deux autres annonçaient.

              ⚠️ LE LIBELLÉ DU BOUTON RESTE « Savoir si je peux signer »
              (décision Johan). Il nomme le BÉNÉFICE du visiteur ; « Analyser
              votre devis » nommerait notre tâche. C'est déjà la raison pour
              laquelle il avait été écrit ainsi le 14/09.

              🔴 CE HERO N'EST INTERPRÉTABLE QU'AVEC LA MESURE DE SCROLL. Il
              parie que le visiteur descend jusqu'aux arguments — et nous
              n'avions AUCUNE donnée là-dessus. Le « 90 % ne voient qu'une
              page » du 14/09 dit qu'ils ne NAVIGUENT pas, pas qu'ils ne
              scrollent pas. Les jalons `accueil_scroll_25/50/75` sont posés en
              même temps que ce changement : sans eux, une baisse de conversion
              ne pourrait pas être attribuée.
              ⚠️ Et il n'existe AUCUN A/B dans le projet : la comparaison sera
              séquentielle, donc fragile — le trafic a été divisé par 5 le
              19/09 et sa composition a changé (fin de la campagne Meta). */}
          <div class="vh-top">
            <h1 class="vh-title">
              Votre devis est-il trop cher…<br />
              ou <span class="vh-mark">risqué&nbsp;?<svg viewBox="0 0 200 10" fill="none" aria-hidden="true"><path d="M2 7C48 3 108 2 198 5" stroke="currentColor" class="text-score-green-foreground" stroke-width="4.5" stroke-linecap="round" /></svg></span>
            </h1>

            <div class="vh-actions">
              <a href="/nouvelle-analyse" class="vh-btn vh-btn-primary">
                Savoir si je peux signer
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            </div>

            {/* 🔴 CETTE LIGNE DIT LE MUR, ELLE NE LE DÉGUISE PAS — règle du
                07/09. L'ancienne version (« Analyse immédiate · Compte gratuit
                pour le détail complet ») était FAUSSE : `/nouvelle-analyse`
                redirige vers `/inscription` sans compte.
                ⚠️ CE QUI A CHANGÉ LE 25/09, ET POURQUOI. « Création de compte
                en 30 secondes » était vrai mais soulevait trois objections sans
                y répondre (« je vais devoir donner des données », « ça va être
                long », « que font-ils de mon mail »). Mesuré le 13/09 : 43 %
                seulement de ceux qui atteignent `/inscription` créent un
                compte, et **ceux qui partent ne prennent pas Google, qui est
                pourtant à un clic** (19 inscriptions Google contre 4 par
                formulaire). La ligne porte donc la RÉPONSE au lieu de
                l'objection — et reste vraie : c'est le chemin qu'emploient
                déjà 83 % des inscrits. **Ne pas retirer la mention du compte** :
                ce serait redevenir faux. */}
            <p class="vh-micro">Compte gratuit, en un clic avec Google.</p>
          </div>

        </div>
      </section>

<style>
  /* ── Hero 2026-09-14 ──────────────────────────────────────────────────
     Styles scopés par Astro. Les couleurs viennent des tokens de
     `src/index.css` (--score-green / --score-orange / --score-red) ou du
     blanc translucide sur le dégradé de marque — aucune teinte inventée. */
  /* ⚠️ 2026-09-14 — PAS DE TRAME DE FOND ICI.
     Une première version posait des réglures horizontales en
     `repeating-linear-gradient` (rgba(255,255,255,.05) tous les 34 px) pour
     évoquer le papier d'un devis. À l'écran elles se lisent comme des
     lignes blanches parasites sur le dégradé, pas comme une texture —
     retiré sur retour Johan. Le fond reste le dégradé de marque, net. */
  .vmd-hero { position: relative; overflow: hidden; }

  /* ── Photo « poignée de main » (handoff validé 2026-09-25, variante G) ─
     Le fond photo du 23/09 était une `background-image` pleine largeur sous
     un voile navy. Il est remplacé par une photo CADRÉE sur la moitié droite,
     et par une vraie balise `<img>` — ce qui permet deux cadrages (`<picture>`)
     et un `alt` pour le lecteur d'écran, impossibles avec un fond CSS. */

  /* ── MOBILE : bandeau en tête, avant le texte ─────────────────────── */
  /* 🔴 LA HAUTEUR EST SUR L'IMAGE, PAS SUR LE CONTENEUR, et ça se voit à
     l'écran. Avec `height: 300px` sur le conteneur, l'encart verdict — qui
     remonte de 40 px — DÉBORDAIT et se posait par-dessus le badge
     « 461 devis analysés » du bloc suivant. En laissant le conteneur
     s'adapter, l'encart fait partie du flux et pousse le texte sous lui. */
  /* 🔴 170 px ET PAS 300, ET C'EST UNE MESURE, PAS UN GOÛT (2026-09-25).
     Le bandeau cookies occupe les 242 px du bas de l'écran sur mobile — soit
     29 % de la hauteur, sur la première visite de chaque page. Avec la photo
     à 300 px, le CTA tombait à y=758 et `elementFromPoint` en son centre
     renvoyait le bouton « Accepter » du bandeau : **le bouton principal du
     site n'était pas cliquable tant que les cookies n'étaient pas traités.**
     Budget réel avant le bandeau : 844 − 65 (header) − 242 = 537 px pour la
     photo, le badge, le H1, le lede ET le bouton. ⚠️ Toute reprise du hero
     doit re-mesurer ce recouvrement, pas seulement regarder une capture —
     un bandeau `position: fixed` n'apparaît pas dans les rectangles.
     ⚠️ La source mobile est RECADRÉE pour cette hauteur (780×340, bande
     350→690 de la source) : les trois visages ET la poignée de main y sont.
     Un simple `height` plus court sur l'ancienne bande de 600 px coupait
     la tête des deux hommes — vérifié à l'œil, pas supposé. */
  .vh-photo-wrap { position: relative; }
  .vh-photo { display: block; width: 100%; height: 170px; object-fit: cover; object-position: center 45%; }
  /* Le fondu vers le bas ramène la photo dans le dégradé de marque. Il est
     en ALPHA, jamais en aplat : une couleur figée trancherait au raccord. */
  .vh-photo-veil {
    position: absolute; top: 0; left: 0; right: 0; height: 170px; pointer-events: none;
    background: linear-gradient(180deg, rgba(0,0,0,.10) 0%, transparent 28%),
                linear-gradient(180deg, transparent 45%, hsl(220 62% 28%) 100%);
  }

  /* ── TABLETTE ET DESKTOP : la photo occupe la colonne de droite ────── */
  @media (min-width: 768px) {
    .vh-photo-wrap { position: absolute; top: 0; right: 0; bottom: 0; width: 50%; }
    .vh-photo { height: 100%; }
    .vh-photo-veil { inset: 0; height: auto; }
    /* 🔴 MASQUE, PAS APLAT. Le handoff peint un voile `#0B2A6B` sur le bord
       gauche de la photo ; or ce n'est pas notre navy (`--hero-gradient` va
       de #1B4498 à #1A3366), et l'écart se verrait comme une bande d'une
       autre couleur au raccord. En rendant le bord TRANSPARENT, c'est le
       vrai dégradé de marque qui apparaît dessous : raccord exact par
       construction, et toujours juste si le token change un jour. */
    .vh-photo {
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.45) 14%, #000 30%);
      mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.45) 14%, #000 30%);
    }
    .vh-photo-veil {
      background: linear-gradient(0deg, rgba(4,20,58,.35), transparent 30%);
    }
  }
  /* 🔴 LA PHOTO EST PLAFONNÉE À SA LARGEUR NATIVE, et ce plafond règle deux
     choses mesurées. (1) QUALITÉ : la source fait 896 px ; à 1920 px de
     viewport, 58 % en réclamaient 1 114, soit un agrandissement de 1,24×.
     À 900 px elle est servie à sa définition réelle. (2) MISE EN PAGE : sans
     le plafond, la colonne de texte tombait à 462 px à 1920 px et LES DEUX
     BOUTONS PASSAIENT L'UN SOUS L'AUTRE. Écart assumé avec le handoff, qui
     raisonne sur un cadre de 1 500 px où 58 % valent justement ~870. */
  @media (min-width: 1024px) { .vh-photo-wrap { width: min(58%, 900px); } }

  /* ── Grille du texte ──────────────────────────────────────────────── */
  .vmd-hero-grid {
    position: relative; z-index: 2;
    display: grid;
    grid-template-areas: "top";
    gap: 28px;
    padding: 24px 1rem 48px;
  }
  .vh-top { grid-area: top; }

  /* 🔴 LE TEXTE EST BORNÉ PAR LE BORD DE LA PHOTO, PAS PAR UNE LARGEUR FIXE.
     La photo est positionnée en % du VIEWPORT, le texte vit dans
     `.container` qui est centré et plafonné : les deux ne parlent pas la
     même unité. `50vw`/`42vw` moins la gouttière donne la place réellement
     disponible à toutes les largeurs, sans connaître la géométrie du
     conteneur.
     ⚠️ PREMIÈRE VERSION : une colonne fantôme de 58vw dans la grille. Elle
     ne chevauchait rien, mais elle rognait la colonne de texte à 489 px —
     et les DEUX BOUTONS PASSAIENT L'UN SOUS L'AUTRE (500 px à eux deux).
     Vu à l'écran, invisible au build. */
  /* ⚠️ `(100vw - 100%) / 2` EST LE DÉCALAGE GAUCHE DU CONTENEUR, et l'oublier
     est l'erreur que la mesure a attrapée : `.container` est CENTRÉ, donc sa
     marge gauche grandit avec l'écran. Une borne écrite « 42vw − gouttière »
     marchait à 1440 et faisait DÉBORDER le texte sous la photo à 1920 (texte
     jusqu'à 880 px, photo à partir de 806). Ici `100%` se résout sur la
     largeur du conteneur, donc la formule reste juste à toute largeur sans
     avoir à connaître son plafond. */
  @media (min-width: 768px) {
    .vmd-hero-grid { row-gap: 26px; align-content: center; padding: 64px 1.5rem 72px; }
    .vh-top { max-width: min(440px, calc(50vw - (100vw - 100%) / 2 - 24px)); }
  }
  @media (min-width: 1024px) {
    .vmd-hero-grid { padding: 72px 1.5rem 80px; }
    /* Le bord gauche de la photo suit le même plafond que la photo elle-même :
       `max(42vw, 100vw - 900px)`. Les deux règles doivent bouger ensemble. */
    .vh-top {
      max-width: min(560px, calc(max(42vw, 100vw - 900px) - (100vw - 100%) / 2 - 24px));
    }
  }


  .vh-title {
    font-size: clamp(1.95rem, 5.4vw, 3.4rem);
    line-height: 1.05; letter-spacing: -.03em; font-weight: 700;
    color: #fff; margin: 0 0 12px; text-wrap: balance;
  }
  .vh-mark { position: relative; white-space: nowrap; }
  .vh-mark svg { position: absolute; left: 0; bottom: -.13em; width: 100%; height: .18em; overflow: visible; }

  .vh-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 14px; }
  .vh-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    font-weight: 700; font-size: .97rem; min-height: 48px;
    padding: 14px 24px; border-radius: 13px; border: 1px solid transparent;
    text-decoration: none; transition: transform .15s ease, background-color .15s ease, border-color .15s ease;
  }
