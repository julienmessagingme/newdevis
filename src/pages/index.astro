<script>
  /**
   * 🔴 PROFONDEUR DE SCROLL SUR L'ACCUEIL — 2026-09-25.
   *
   * POURQUOI MAINTENANT. Le hero épuré du même jour déplace tous les arguments
   * SOUS la ligne de flottaison. Toute l'idée repose sur l'hypothèse que le
   * visiteur descend — et nous n'avions aucune donnée là-dessus. Le « 90 % des
   * visiteurs ne voient qu'une page » du 14/09 dit qu'ils ne NAVIGUENT pas, pas
   * qu'ils ne scrollent pas ; confondre les deux serait la faute d'indicateur
   * la plus fréquente de ce projet.
   *
   * ⚠️ SANS CETTE MESURE, LE TEST NE DIRAIT RIEN : une baisse de conversion
   * serait indiscernable entre « le hero convertit moins » et « personne
   * n'atteint les arguments ».
   *
   * RGPD : aucun cookie, aucune donnée personnelle. La route `/api/track/event`
   * applique le même régime que `site_visits` — empreinte serveur rotative
   * quotidienne, ni IP ni user-agent conservés.
   */
  (() => {
    // ⚠️ Le garde interne d'abord : sans lui nos propres visites gonflent le
    // dénominateur, exactement comme GA4 compte nos 84 vues d'admin (13/09).
    try {
      if (localStorage.getItem('vmd_internal') === '1') return;
    } catch { /* stockage refusé : on mesure quand même */ }

    const JALONS = [25, 50, 75];
    // ⚠️ Un jalon au plus PAR JOUR et par navigateur : sinon un seul lecteur
    // qui monte et redescend envoie dix fois le même événement et le taux
    // devient un artefact de son comportement de lecture.
    const cle = 'vmd_scroll_' + new Date().toISOString().slice(0, 10);
    let deja: number[] = [];
    try { deja = JSON.parse(sessionStorage.getItem(cle) || '[]'); } catch { /* ignoré */ }

    const envoyer = (pct: number) => {
      deja.push(pct);
      try { sessionStorage.setItem(cle, JSON.stringify(deja)); } catch { /* ignoré */ }
      // `keepalive` : l'événement survit à la navigation qui suit souvent le
      // franchissement d'un jalon (le visiteur descend PUIS clique).
      fetch('/api/track/event', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ event: 'accueil_scroll_' + pct }),
        keepalive: true,
      }).catch(() => { /* une mesure ne casse jamais une page */ });
    };

    let enAttente = false;
    const regarder = () => {
      if (enAttente) return;
      enAttente = true;
      requestAnimationFrame(() => {
        enAttente = false;
        const h = document.documentElement.scrollHeight - window.innerHeight;
        if (h <= 0) return;
        const pct = (window.scrollY / h) * 100;
        for (const j of JALONS) {
          if (pct >= j && !deja.includes(j)) envoyer(j);
        }
        if (deja.length === JALONS.length) window.removeEventListener('scroll', regarder);
      });
    };

    window.addEventListener('scroll', regarder, { passive: true });
    // Un écran très haut peut déjà dépasser 25 % sans le moindre geste.
    regarder();
  })();
</script>
