---
import BaseLayout from '@/layouts/BaseLayout.astro';
// 2026-09-07 — RENDU STATIQUE, PAS UNE ÎLE.
//
// Cette page partait en `client:only="react"` : son contenu n'existait alors
// PAS dans le HTML servi (27 Ko de page pour zéro texte indexable). Sur une
// page dont la raison d'être est le référencement, c'est le défaut le plus
// coûteux qu'on puisse avoir.
//
// La règle « toujours client:only » de CLAUDE.md protège les composants
// INTERACTIFS (sans elle, leurs gestionnaires d'événements sont perdus). Ici il
// n'y a ni état, ni effet, ni gestionnaire : ni dans la page, ni dans aucun de
// ses composants (Breadcrumb, ObservatoireChip, Disclaimer, CrossLinks). Sans
// directive, Astro la rend en HTML au build — texte indexable, zéro JS envoyé.
//
// ⚠️ Ajouter la moindre interactivité ici obligerait à repasser en île.
import ObservatoireMetierPage from '@/components/pages/seo/ObservatoireMetierPage';
import { articleSchema, breadcrumbSchema, combineSchemas } from '@/lib/seo/schemaOrg';
import { getRelatedLinks } from '@/lib/seo/internalLinking';

export async function getStaticPaths() {
  const fs = await import('node:fs');
  const path = await import('node:path');
  const dir = path.resolve('./src/data/observatoire/metiers');
  if (!fs.existsSync(dir)) return [];

  const files = fs.readdirSync(dir).filter((f) => f.endsWith('.json') && !f.startsWith('_'));
  return files.map((file) => {
    const data = JSON.parse(fs.readFileSync(path.join(dir, file), 'utf-8'));
    return { params: { slug: data.slug }, props: { data } };
  });
}

const { data } = Astro.props;
const url = `https://www.verifiermondevis.fr/observatoire/metiers/${data.slug}`;

const breadcrumbs = breadcrumbSchema([
  { name: 'Accueil', url: 'https://www.verifiermondevis.fr/' },
  { name: 'Observatoire', url: 'https://www.verifiermondevis.fr/observatoire' },
  { name: 'Métiers', url: 'https://www.verifiermondevis.fr/observatoire/metiers' },
  { name: data.metier_label, url },
]);

const article = articleSchema({
  title: data.title,
  description: data.description,
  url,
  datePublished: data.lastGenerated,
  dateModified: data.lastGenerated,
});

const schemas = combineSchemas(article, breadcrumbs);
const related = getRelatedLinks(['verifier', 'prix'], `/observatoire/metiers/${data.slug}`, { count: 4 });

export const prerender = true;
---

<BaseLayout title={data.title + ' | VerifierMonDevis.fr'} description={data.description}>
  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  <ObservatoireMetierPage data={data} related={related} />
</BaseLayout>
