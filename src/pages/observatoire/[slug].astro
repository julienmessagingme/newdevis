---
import BaseLayout from '@/layouts/BaseLayout.astro';
// 2026-09-21 — RENDU STATIQUE, PAS UNE ÎLE.
//
// Même défaut que les pages métier le 07/09, resté ouvert sur les 5 études :
// `client:only="react"` ne rend RIEN côté serveur, donc le HTML servi ne
// contenait pas une ligne du texte — mesuré en production, 24 à 28 Ko de page
// pour ZÉRO H1. Sur une page dont la raison d'être est le référencement, c'est
// le défaut le plus coûteux qu'on puisse avoir.
//
// ⚠️ ON IMPORTE LE COMPOSANT DIRECTEMENT, JAMAIS LE WRAPPER `EtudeVmdApp` :
// celui-ci enveloppe la page dans `lazy()` + `<Suspense>`, et sans directive
// client Astro rendrait alors le SPINNER de repli en guise de contenu.
//
// Vérifié avant bascule, chaîne d'imports comprise : ni état, ni effet, ni
// gestionnaire dans EtudeVmdPage, Breadcrumb, ObservatoireChip, Disclaimer ni
// CrossLinks. ⚠️ Y ajouter la moindre interactivité obligerait à repasser en île.
import EtudeVmdPage from '@/components/pages/seo/EtudeVmdPage';
import { articleSchema, breadcrumbSchema, combineSchemas } from '@/lib/seo/schemaOrg';
import { getRelatedLinks } from '@/lib/seo/internalLinking';

// Static path generation depuis les JSON committés
export async function getStaticPaths() {
  const fs = await import('node:fs');
  const path = await import('node:path');
  const dir = path.resolve('./src/data/observatoire');
  if (!fs.existsSync(dir)) return [];

  const files = fs.readdirSync(dir).filter((f) => f.endsWith('.json') && !f.startsWith('_'));
  return files.map((file) => {
    const data = JSON.parse(fs.readFileSync(path.join(dir, file), 'utf-8'));
    return { params: { slug: data.slug }, props: { data } };
  });
}

const { data } = Astro.props;
const url = `https://www.verifiermondevis.fr/observatoire/${data.slug}`;

const breadcrumbs = breadcrumbSchema([
  { name: 'Accueil', url: 'https://www.verifiermondevis.fr/' },
  { name: 'Observatoire', url: 'https://www.verifiermondevis.fr/observatoire' },
  { name: data.title, url },
]);

const article = articleSchema({
  title: data.title,
  description: data.description,
  url,
  datePublished: data.lastGenerated,
  dateModified: data.lastGenerated,
});

const schemas = combineSchemas(article, breadcrumbs);

const related = getRelatedLinks(['verifier', 'prix'], `/observatoire/${data.slug}`, { count: 4, excludeTypes: ['study'] });

export const prerender = true;
---

<BaseLayout title={data.title + ' | VerifierMonDevis.fr'} description={data.description}>
  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  <EtudeVmdPage data={data} related={related} />
</BaseLayout>
